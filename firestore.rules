rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'asaredesmond873@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function utcDateKey() {
      return string(request.time.year())
        + '_'
        + (request.time.month() < 10 ? '0' + string(request.time.month()) : string(request.time.month()))
        + '_'
        + (request.time.day() < 10 ? '0' + string(request.time.day()) : string(request.time.day()));
    }

    function hasActiveCreatorPass(uid) {
      return exists(/databases/$(database)/documents/creatorSubscriptions/$(uid + '__moodspace_pass'))
        && get(/databases/$(database)/documents/creatorSubscriptions/$(uid + '__moodspace_pass')).data.status == 'active'
        && get(/databases/$(database)/documents/creatorSubscriptions/$(uid + '__moodspace_pass')).data.expiresAt > request.time.toMillis();
    }

    function willHaveActiveCreatorPass(uid) {
      return existsAfter(/databases/$(database)/documents/creatorSubscriptions/$(uid + '__moodspace_pass'))
        && getAfter(/databases/$(database)/documents/creatorSubscriptions/$(uid + '__moodspace_pass')).data.status == 'active'
        && getAfter(/databases/$(database)/documents/creatorSubscriptions/$(uid + '__moodspace_pass')).data.expiresAt > request.time.toMillis();
    }

    // --- Validation Blueprints ---

    function isValidPublicProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'bio', 'location', 'accountType', 'avatarUrl', 'isPublic', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'bio', 'location', 'accountType', 'avatarUrl', 'isPublic',
          'badgeVerified', 'verifiedLabel', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.bio is string && data.bio.size() <= 500
        && data.location is string && data.location.size() <= 100
        && data.accountType in ['creator', 'business', 'community']
        && data.avatarUrl is string && data.avatarUrl.size() <= 150000
        && data.isPublic is bool && data.isPublic == true
        && (!('badgeVerified' in data) || data.badgeVerified is bool)
        && (!('verifiedLabel' in data) || (data.verifiedLabel is string && data.verifiedLabel.size() <= 60))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFollowRecord(data) {
      return data.keys().hasAll([
          'followerId', 'followingId', 'displayName', 'avatarUrl', 'location', 'createdAt'
        ])
        && data.keys().hasOnly([
          'followerId', 'followingId', 'displayName', 'avatarUrl', 'location', 'createdAt'
        ])
        && isValidId(data.followerId)
        && isValidId(data.followingId)
        && data.followerId != data.followingId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.avatarUrl is string && data.avatarUrl.size() <= 150000
        && data.location is string && data.location.size() <= 100
        && data.createdAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedPost(data) {
      return data.keys().hasAll(['userId', 'postId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'postId', 'createdAt'])
        && isValidId(data.userId)
        && isValidId(data.postId)
        && data.createdAt is timestamp;
    }

    function isValidVerificationRequest(data) {
      return data.keys().hasAll([
          'uid', 'requesterName', 'requesterLocation', 'accountType',
          'legalOrBrandName', 'category', 'idType', 'idReference',
          'proofLink', 'proofImageUrl', 'note', 'proposedLabel',
          'status', 'reviewNote', 'reviewedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'requesterName', 'requesterLocation', 'accountType',
          'legalOrBrandName', 'category', 'idType', 'idReference',
          'proofLink', 'proofImageUrl', 'note', 'proposedLabel',
          'status', 'reviewNote', 'reviewedBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 80
        && data.requesterLocation is string && data.requesterLocation.size() <= 100
        && data.accountType in ['creator', 'business', 'community']
        && data.legalOrBrandName is string && data.legalOrBrandName.size() >= 1 && data.legalOrBrandName.size() <= 120
        && data.category in ['creator', 'business', 'organizer', 'media']
        && data.idType in ['ghana_card', 'business_reg', 'social_handle', 'website_press']
        && data.idReference is string && data.idReference.size() >= 1 && data.idReference.size() <= 140
        && data.proofLink is string && data.proofLink.size() <= 500
        && data.proofImageUrl is string && data.proofImageUrl.size() <= 450000
        && data.note is string && data.note.size() <= 1000
        && data.proposedLabel is string && data.proposedLabel.size() <= 60
        && data.status in ['pending', 'approved', 'rejected']
        && data.reviewNote is string && data.reviewNote.size() <= 500
        && data.reviewedBy is string && data.reviewedBy.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFormConfig(fc) {
      return fc is map
        && fc.keys().hasAll(['title', 'description', 'isOpen', 'fields'])
        && fc.keys().hasOnly(['title', 'description', 'isOpen', 'fields'])
        && fc.title is string && fc.title.size() <= 120
        && fc.description is string && fc.description.size() <= 500
        && fc.isOpen is bool
        && fc.fields is list && fc.fields.size() <= 15
        && (
          fc.fields.size() == 0 || (
            fc.fields[0] is map
            && fc.fields[0].keys().hasAll(['id', 'label', 'type', 'required', 'options'])
            && fc.fields[0].keys().hasOnly(['id', 'label', 'type', 'required', 'options'])
            && fc.fields[0].id is string && fc.fields[0].id.size() <= 64
            && fc.fields[0].label is string && fc.fields[0].label.size() <= 100
            && fc.fields[0].type in ['text', 'email', 'tel', 'textarea', 'select', 'checkbox']
            && fc.fields[0].required is bool
            && fc.fields[0].options is list && fc.fields[0].options.size() <= 20
          )
        );
    }

    function isValidPost(data) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'authorAvatar', 'authorLocation',
          'category', 'mediaFormat', 'visibility', 'title', 'content',
          'photoUrl', 'videoUrl', 'eventDate', 'eventLocation', 'promoCode',
          'hasForm', 'formConfig', 'likesCount', 'commentsCount', 'sharesCount',
          'submissionsCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'authorAvatar', 'authorLocation',
          'category', 'mediaFormat', 'visibility', 'title', 'content',
          'photoUrl', 'videoUrl', 'eventDate', 'eventLocation', 'promoCode',
          'hasForm', 'formConfig', 'likesCount', 'commentsCount', 'sharesCount',
          'submissionsCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorAvatar is string && data.authorAvatar.size() <= 150000
        && data.authorLocation is string && data.authorLocation.size() <= 100
        && data.category in ['announcement', 'event', 'promo']
        && data.mediaFormat in ['text', 'photo', 'video', 'mix']
        && data.visibility in ['public', 'archived']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 4000
        && data.photoUrl is string && data.photoUrl.size() <= 450000
        && data.videoUrl is string && data.videoUrl.size() <= 2000
        && data.eventDate is string && data.eventDate.size() <= 60
        && data.eventLocation is string && data.eventLocation.size() <= 120
        && data.promoCode is string && data.promoCode.size() <= 40
        && data.hasForm is bool
        && isValidFormConfig(data.formConfig)
        && data.likesCount is int && data.likesCount >= 0
        && data.commentsCount is int && data.commentsCount >= 0
        && data.sharesCount is int && data.sharesCount >= 0
        && data.submissionsCount is int && data.submissionsCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPostLike(data) {
      return data.keys().hasAll(['userId', 'postId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'postId', 'createdAt'])
        && isValidId(data.userId)
        && isValidId(data.postId)
        && data.createdAt is timestamp;
    }

    function isValidPostComment(data) {
      return data.keys().hasAll(['id', 'postId', 'authorId', 'authorName', 'authorAvatar', 'text', 'createdAt'])
        && data.keys().hasOnly(['id', 'postId', 'authorId', 'authorName', 'authorAvatar', 'text', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.postId)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorAvatar is string && data.authorAvatar.size() <= 150000
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidFormSubmission(data) {
      return data.keys().hasAll(['id', 'postId', 'postAuthorId', 'submitterId', 'submitterName', 'answers', 'createdAt'])
        && data.keys().hasOnly(['id', 'postId', 'postAuthorId', 'submitterId', 'submitterName', 'answers', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.postId)
        && isValidId(data.postAuthorId)
        && isValidId(data.submitterId)
        && data.submitterName is string && data.submitterName.size() >= 1 && data.submitterName.size() <= 80
        && data.answers is map && data.answers.size() <= 15
        && data.createdAt is timestamp;
    }

    // --- Video Arena Validation Blueprints ---

    function isValidChallengeVideo(data) {
      return data.keys().hasAll([
          'id', 'roundId', 'authorId', 'authorName', 'authorAvatar', 'authorLocation',
          'title', 'caption', 'thumbnailUrl', 'mimeType', 'durationSeconds', 'fileSizeBytes',
          'chunkCount', 'videoReady', 'isActive', 'likesCount', 'commentsCount', 'sharesCount',
          'viewsCount', 'votesCount', 'giftsCount', 'giftsTotalGhs', 'boostedUntil', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'roundId', 'authorId', 'authorName', 'authorAvatar', 'authorLocation',
          'title', 'caption', 'thumbnailUrl', 'mimeType', 'durationSeconds', 'fileSizeBytes',
          'chunkCount', 'videoReady', 'isActive', 'likesCount', 'commentsCount', 'sharesCount',
          'viewsCount', 'votesCount', 'giftsCount', 'giftsTotalGhs', 'boostedUntil', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.roundId) && data.roundId.size() <= 64
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorAvatar is string && data.authorAvatar.size() <= 150000
        && data.authorLocation is string && data.authorLocation.size() <= 100
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.caption is string && data.caption.size() <= 400
        && data.thumbnailUrl is string && data.thumbnailUrl.size() <= 200000
        && data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 60
        && data.durationSeconds is number && data.durationSeconds >= 30 && data.durationSeconds <= 90
        && data.fileSizeBytes is int && data.fileSizeBytes > 0 && data.fileSizeBytes < 15728640
        && data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 40
        && data.videoReady is bool
        && data.isActive is bool
        && data.likesCount is int && data.likesCount >= 0
        && data.commentsCount is int && data.commentsCount >= 0
        && data.sharesCount is int && data.sharesCount >= 0
        && data.viewsCount is int && data.viewsCount >= 0
        && data.votesCount is int && data.votesCount >= 0
        && data.giftsCount is int && data.giftsCount >= 0
        && data.giftsTotalGhs is int && data.giftsTotalGhs >= 0
        && data.boostedUntil is int && data.boostedUntil >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChallengeVideoChunk(data) {
      return data.keys().hasAll(['videoId', 'authorId', 'index', 'data'])
        && data.keys().hasOnly(['videoId', 'authorId', 'index', 'data'])
        && isValidId(data.videoId)
        && isValidId(data.authorId)
        && data.index is int && data.index >= 0 && data.index < 40
        && data.data is string && data.data.size() >= 1 && data.data.size() <= 750000;
    }

    function isValidChallengeVideoLike(data) {
      return data.keys().hasAll(['userId', 'videoId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'videoId', 'createdAt'])
        && isValidId(data.userId)
        && isValidId(data.videoId)
        && data.createdAt is timestamp;
    }

    function isValidChallengeVideoComment(data) {
      return data.keys().hasAll(['id', 'videoId', 'authorId', 'authorName', 'authorAvatar', 'text', 'createdAt'])
        && data.keys().hasOnly(['id', 'videoId', 'authorId', 'authorName', 'authorAvatar', 'text', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.videoId)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorAvatar is string && data.authorAvatar.size() <= 150000
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 500
        && data.createdAt is timestamp;
    }

    function isValidChallengeVideoGift(data) {
      return data.keys().hasAll(['id', 'videoId', 'senderId', 'senderName', 'giftType', 'amountGhs', 'createdAt'])
        && data.keys().hasOnly(['id', 'videoId', 'senderId', 'senderName', 'giftType', 'amountGhs', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.videoId)
        && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.giftType in ['rose', 'fire', 'lion']
        && data.amountGhs is int
        && (
          (data.giftType == 'rose' && data.amountGhs == 2)
          || (data.giftType == 'fire' && data.amountGhs == 5)
          || (data.giftType == 'lion' && data.amountGhs == 20)
        )
        && data.createdAt is timestamp;
    }

    function isValidChallengeVideoBoost(data) {
      return data.keys().hasAll(['id', 'videoId', 'payerId', 'provider', 'maskedPhone', 'amountGhs', 'boostedUntil', 'createdAt'])
        && data.keys().hasOnly(['id', 'videoId', 'payerId', 'provider', 'maskedPhone', 'amountGhs', 'boostedUntil', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.videoId)
        && isValidId(data.payerId)
        && data.provider in ['MTN MoMo', 'M-Pesa', 'Airtel Money', 'Telecel Cash', 'AirtelTigo Money']
        && data.maskedPhone is string && data.maskedPhone.size() >= 4 && data.maskedPhone.size() <= 20
        && data.amountGhs is int && data.amountGhs == 20
        && data.boostedUntil is int && data.boostedUntil > 0
        && data.createdAt is timestamp;
    }

    function isValidChallengeDailyVote(data) {
      return data.keys().hasAll(['userId', 'dateKey', 'videoId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'dateKey', 'videoId', 'createdAt'])
        && isValidId(data.userId)
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}_[0-9]{2}_[0-9]{2}$')
        && isValidId(data.videoId)
        && data.createdAt is timestamp;
    }

    function isValidChallengeConfig(data) {
      return data.keys().hasAll([
          'isPublic', 'sponsorName', 'prizeGhs', 'winnerVideoId', 'winnerName',
          'winnerLocation', 'winnerTitle', 'winnerThumbnailUrl', 'winnerRoundLabel', 'winnerPrizeGhs', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'isPublic', 'sponsorName', 'prizeGhs', 'winnerVideoId', 'winnerName',
          'winnerLocation', 'winnerTitle', 'winnerThumbnailUrl', 'winnerRoundLabel', 'winnerPrizeGhs', 'updatedAt'
        ])
        && data.isPublic is bool && data.isPublic == true
        && data.sponsorName is string && data.sponsorName.size() >= 1 && data.sponsorName.size() <= 80
        && data.prizeGhs is int && data.prizeGhs >= 0
        && data.winnerVideoId is string && data.winnerVideoId.size() <= 128
        && data.winnerName is string && data.winnerName.size() <= 80
        && data.winnerLocation is string && data.winnerLocation.size() <= 100
        && data.winnerTitle is string && data.winnerTitle.size() <= 120
        && data.winnerThumbnailUrl is string && data.winnerThumbnailUrl.size() <= 200000
        && data.winnerRoundLabel is string && data.winnerRoundLabel.size() <= 60
        && data.winnerPrizeGhs is int && data.winnerPrizeGhs >= 0
        && data.updatedAt is timestamp;
    }

    function isValidSavedVideo(data) {
      return data.keys().hasAll(['userId', 'videoId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'videoId', 'createdAt'])
        && isValidId(data.userId)
        && isValidId(data.videoId)
        && data.createdAt is timestamp;
    }

    function isValidProfileView(data) {
      return data.keys().hasAll([
          'profileUid', 'viewerId', 'viewerName', 'viewerAvatar', 'viewerLocation', 'viewedAt'
        ])
        && data.keys().hasOnly([
          'profileUid', 'viewerId', 'viewerName', 'viewerAvatar', 'viewerLocation', 'viewedAt'
        ])
        && isValidId(data.profileUid)
        && isValidId(data.viewerId)
        && data.profileUid != data.viewerId
        && data.viewerName is string && data.viewerName.size() >= 1 && data.viewerName.size() <= 80
        && data.viewerAvatar is string && data.viewerAvatar.size() <= 150000
        && data.viewerLocation is string && data.viewerLocation.size() <= 100
        && data.viewedAt is timestamp;
    }

    function isValidCreatorSubscription(data) {
      return data.keys().hasAll([
          'id', 'subscriberId', 'subscriberName', 'targetId', 'targetName',
          'planType', 'usdAmount', 'currency', 'localAmount', 'country',
          'paymentProvider', 'paystackReference', 'status',
          'expiresAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'subscriberId', 'subscriberName', 'targetId', 'targetName',
          'planType', 'usdAmount', 'currency', 'localAmount', 'country',
          'paymentProvider', 'paystackReference', 'status',
          'expiresAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.subscriberId)
        && data.subscriberName is string && data.subscriberName.size() >= 1 && data.subscriberName.size() <= 80
        && isValidId(data.targetId) && data.targetId == 'moodspace_pass'
        && data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 80
        && data.planType == 'creator_pass'
        && data.usdAmount is int && data.usdAmount == 10
        && data.currency in ['GHS', 'NGN', 'KES', 'ZAR', 'USD']
        && data.localAmount is number && data.localAmount > 0
        && data.country is string && data.country.size() >= 2 && data.country.size() <= 80
        && data.paymentProvider == 'Paystack'
        && data.paystackReference is string && data.paystackReference.size() >= 4 && data.paystackReference.size() <= 120
        && data.status in ['active', 'cancelled']
        && data.expiresAt is int && data.expiresAt > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /publicProfiles/{userId} {
      allow get: if isValidId(userId) && (existing().isPublic == true || isOwner(userId) || isAdmin());
      allow list: if existing().isPublic == true || (isSignedIn() && existing().uid == request.auth.uid) || isAdmin();
      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPublicProfile(incoming())
        && incoming().uid == request.auth.uid
        && (!('badgeVerified' in incoming()) || incoming().badgeVerified == false)
        && (!('verifiedLabel' in incoming()) || incoming().verifiedLabel == '')
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isValidPublicProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'bio', 'location', 'accountType', 'avatarUrl', 'updatedAt'
            ])
          )
          || (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'badgeVerified', 'verifiedLabel', 'updatedAt'
            ])
            && (
              (
                incoming().badgeVerified == true
                && incoming().verifiedLabel == 'Verified Creator'
                && willHaveActiveCreatorPass(userId)
              )
              || (
                incoming().badgeVerified == false
                && incoming().verifiedLabel == ''
                && !willHaveActiveCreatorPass(userId)
              )
            )
          )
          || (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'badgeVerified', 'verifiedLabel', 'updatedAt'
            ])
            && incoming().badgeVerified is bool
            && incoming().verifiedLabel is string
          )
        );
      allow delete: if false;

      match /followers/{followerId} {
        allow get: if isValidId(userId) && isValidId(followerId);
        allow list: if isValidId(userId) && existing().followingId == userId;
        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(followerId)
          && isOwner(followerId)
          && followerId != userId
          && isValidFollowRecord(incoming())
          && incoming().followerId == request.auth.uid
          && incoming().followingId == userId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/publicProfiles/$(userId))
          && exists(/databases/$(database)/documents/publicProfiles/$(followerId))
          && existsAfter(/databases/$(database)/documents/publicProfiles/$(followerId)/following/$(userId));
        allow update: if false;
        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(followerId)
          && isOwner(followerId)
          && !existsAfter(/databases/$(database)/documents/publicProfiles/$(followerId)/following/$(userId));
      }

      match /following/{followingId} {
        allow get: if isValidId(userId) && isValidId(followingId);
        allow list: if isValidId(userId) && existing().followerId == userId;
        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(followingId)
          && isOwner(userId)
          && userId != followingId
          && isValidFollowRecord(incoming())
          && incoming().followerId == request.auth.uid
          && incoming().followingId == followingId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/publicProfiles/$(userId))
          && exists(/databases/$(database)/documents/publicProfiles/$(followingId))
          && existsAfter(/databases/$(database)/documents/publicProfiles/$(followingId)/followers/$(userId));
        allow update: if false;
        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(followingId)
          && isOwner(userId)
          && !existsAfter(/databases/$(database)/documents/publicProfiles/$(followingId)/followers/$(userId));
      }

      match /profileViews/{viewerId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(viewerId)
          && isOwner(userId)
          && hasActiveCreatorPass(userId);
        allow list: if isSignedIn()
          && isValidId(userId)
          && isOwner(userId)
          && existing().profileUid == userId
          && hasActiveCreatorPass(userId);
        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(viewerId)
          && isOwner(viewerId)
          && viewerId != userId
          && isValidProfileView(incoming())
          && incoming().profileUid == userId
          && incoming().viewerId == request.auth.uid
          && incoming().viewedAt == request.time
          && exists(/databases/$(database)/documents/publicProfiles/$(userId));
        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(viewerId)
          && isOwner(viewerId)
          && viewerId != userId
          && isValidProfileView(incoming())
          && incoming().profileUid == existing().profileUid
          && incoming().viewerId == existing().viewerId
          && incoming().viewedAt == request.time;
        allow delete: if false;
      }
    }

    match /userPrivate/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isSignedIn() && existing().uid == request.auth.uid;
      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivate(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivate(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
      allow delete: if false;

      match /savedPosts/{postId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(postId) && isOwner(userId);
        allow list: if isSignedIn() && isValidId(userId) && isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(postId)
          && isOwner(userId)
          && isValidSavedPost(incoming())
          && incoming().userId == request.auth.uid
          && incoming().postId == postId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId));
        allow update: if false;
        allow delete: if isVerified() && isValidId(userId) && isValidId(postId) && isOwner(userId);
      }

      match /savedVideos/{videoId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(videoId) && isOwner(userId);
        allow list: if isSignedIn() && isValidId(userId) && isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(videoId)
          && isOwner(userId)
          && isValidSavedVideo(incoming())
          && incoming().userId == request.auth.uid
          && incoming().videoId == videoId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/challengeVideos/$(videoId));
        allow update: if false;
        allow delete: if isVerified() && isValidId(userId) && isValidId(videoId) && isOwner(userId);
      }
    }

    match /verificationRequests/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidVerificationRequest(incoming())
        && incoming().uid == userId
        && incoming().status == 'pending'
        && incoming().reviewNote == ''
        && incoming().reviewedBy == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isValidVerificationRequest(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId)
            && incoming().status == 'pending'
            && incoming().reviewNote == ''
            && incoming().reviewedBy == ''
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'requesterName', 'requesterLocation', 'accountType',
              'legalOrBrandName', 'category', 'idType', 'idReference',
              'proofLink', 'proofImageUrl', 'note', 'proposedLabel',
              'status', 'reviewNote', 'reviewedBy', 'updatedAt'
            ])
          )
          || (
            isAdmin()
            && incoming().status in ['approved', 'rejected']
            && incoming().reviewedBy == request.auth.token.email
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'proposedLabel', 'reviewNote', 'reviewedBy', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /posts/{postId} {
      allow get: if isValidId(postId) && (existing().visibility == 'public' || (isSignedIn() && existing().authorId == request.auth.uid));
      allow list: if existing().visibility == 'public' || (isSignedIn() && existing().authorId == request.auth.uid);

      allow create: if isVerified()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().id == postId
        && incoming().authorId == request.auth.uid
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().sharesCount == 0
        && incoming().submissionsCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().authorId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authorName', 'authorAvatar', 'authorLocation',
              'category', 'mediaFormat', 'visibility', 'title', 'content',
              'photoUrl', 'videoUrl', 'eventDate', 'eventLocation', 'promoCode',
              'hasForm', 'formConfig', 'updatedAt'
            ])
          )
          || (
            existing().visibility == 'public'
            && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && (
              (incoming().likesCount == existing().likesCount + 1 && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))
              || (incoming().likesCount == existing().likesCount - 1 && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))
            )
          )
          || (
            existing().visibility == 'public'
            && incoming().diff(existing()).affectedKeys().hasOnly(['sharesCount', 'updatedAt'])
            && incoming().sharesCount == existing().sharesCount + 1
          )
          || (
            existing().visibility == 'public'
            && incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
            && (incoming().commentsCount == existing().commentsCount + 1 || incoming().commentsCount == existing().commentsCount - 1)
          )
          || (
            existing().visibility == 'public'
            && existing().hasForm == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['submissionsCount', 'updatedAt'])
            && incoming().submissionsCount == existing().submissionsCount + 1
          )
        );

      allow delete: if isVerified()
        && isValidId(postId)
        && existing().authorId == request.auth.uid;

      match /likes/{userId} {
        allow get: if isValidId(postId) && isValidId(userId) && isOwner(userId);
        allow list: if isSignedIn() && existing().userId == request.auth.uid;
        allow create: if isVerified()
          && isValidId(postId)
          && isValidId(userId)
          && isOwner(userId)
          && isValidPostLike(incoming())
          && incoming().userId == request.auth.uid
          && incoming().postId == postId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId))
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.likesCount == get(/databases/$(database)/documents/posts/$(postId)).data.likesCount + 1;
        allow update: if false;
        allow delete: if isVerified()
          && isValidId(postId)
          && isValidId(userId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.likesCount == get(/databases/$(database)/documents/posts/$(postId)).data.likesCount - 1;
      }

      match /comments/{commentId} {
        allow get: if isValidId(postId)
          && isValidId(commentId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && (
            get(/databases/$(database)/documents/posts/$(postId)).data.visibility == 'public'
            || (isSignedIn() && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid)
          );
        allow list: if isValidId(postId)
          && existing().postId == postId;
        allow create: if isVerified()
          && isValidId(postId)
          && isValidId(commentId)
          && isValidPostComment(incoming())
          && incoming().id == commentId
          && incoming().postId == postId
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId))
          && get(/databases/$(database)/documents/posts/$(postId)).data.visibility == 'public'
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.commentsCount == get(/databases/$(database)/documents/posts/$(postId)).data.commentsCount + 1;
        allow update: if false;
        allow delete: if isVerified()
          && isValidId(postId)
          && isValidId(commentId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && (
            existing().authorId == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
          )
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.commentsCount == get(/databases/$(database)/documents/posts/$(postId)).data.commentsCount - 1;
      }

      match /submissions/{submissionId} {
        allow get: if isSignedIn()
          && isValidId(postId)
          && isValidId(submissionId)
          && (existing().postAuthorId == request.auth.uid || existing().submitterId == request.auth.uid);
        allow list: if isSignedIn()
          && (existing().postAuthorId == request.auth.uid || existing().submitterId == request.auth.uid);
        allow create: if isVerified()
          && isValidId(postId)
          && isValidId(submissionId)
          && isValidFormSubmission(incoming())
          && incoming().id == submissionId
          && incoming().postId == postId
          && incoming().submitterId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId))
          && get(/databases/$(database)/documents/posts/$(postId)).data.visibility == 'public'
          && get(/databases/$(database)/documents/posts/$(postId)).data.hasForm == true
          && get(/databases/$(database)/documents/posts/$(postId)).data.formConfig.isOpen == true
          && incoming().postAuthorId == get(/databases/$(database)/documents/posts/$(postId)).data.authorId
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.submissionsCount == get(/databases/$(database)/documents/posts/$(postId)).data.submissionsCount + 1;
        allow update: if false;
        allow delete: if isVerified()
          && isValidId(postId)
          && isValidId(submissionId)
          && (existing().postAuthorId == request.auth.uid || existing().submitterId == request.auth.uid);
      }
    }

    // --- Video Arena Collections ---

    match /challengeConfig/{configId} {
      allow get: if isValidId(configId);
      allow list: if existing().isPublic == true;
      allow create, update: if isAdmin()
        && isValidId(configId)
        && isValidChallengeConfig(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /challengeDailyVotes/{voteId} {
      allow get: if isSignedIn() && isValidId(voteId) && voteId.matches('^' + request.auth.uid + '__[0-9]{4}_[0-9]{2}_[0-9]{2}$');
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(voteId)
        && isValidChallengeDailyVote(incoming())
        && incoming().userId == request.auth.uid
        && incoming().dateKey == utcDateKey()
        && voteId == request.auth.uid + '__' + incoming().dateKey
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/challengeVideos/$(incoming().videoId))
        && getAfter(/databases/$(database)/documents/challengeVideos/$(incoming().videoId)).data.votesCount == get(/databases/$(database)/documents/challengeVideos/$(incoming().videoId)).data.votesCount + 1;
      allow update, delete: if false;
    }

    match /challengeVideos/{videoId} {
      allow get: if isValidId(videoId);
      allow list: if existing().isActive == true;

      allow create: if isVerified()
        && isValidId(videoId)
        && hasActiveCreatorPass(request.auth.uid)
        && isValidChallengeVideo(incoming())
        && incoming().id == videoId
        && incoming().authorId == request.auth.uid
        && videoId == incoming().roundId + '__' + request.auth.uid
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().sharesCount == 0
        && incoming().viewsCount == 0
        && incoming().votesCount == 0
        && incoming().giftsCount == 0
        && incoming().giftsTotalGhs == 0
        && incoming().boostedUntil == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(videoId)
        && isValidChallengeVideo(incoming())
        && incoming().id == existing().id
        && incoming().roundId == existing().roundId
        && incoming().authorId == existing().authorId
        && incoming().durationSeconds == existing().durationSeconds
        && incoming().fileSizeBytes == existing().fileSizeBytes
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Owner edits caption/title or marks chunk upload complete
          (
            isOwner(existing().authorId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'caption', 'thumbnailUrl', 'videoReady', 'chunkCount', 'updatedAt'
            ])
          )
          // Action 2: Atomic like toggle
          || (
            existing().isActive == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && (
              (incoming().likesCount == existing().likesCount + 1 && existsAfter(/databases/$(database)/documents/challengeVideos/$(videoId)/likes/$(request.auth.uid)))
              || (incoming().likesCount == existing().likesCount - 1 && !existsAfter(/databases/$(database)/documents/challengeVideos/$(videoId)/likes/$(request.auth.uid)))
            )
          )
          // Action 3: Comment count sync
          || (
            existing().isActive == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
            && (incoming().commentsCount == existing().commentsCount + 1 || incoming().commentsCount == existing().commentsCount - 1)
          )
          // Action 4: Share count increment
          || (
            existing().isActive == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['sharesCount', 'updatedAt'])
            && incoming().sharesCount == existing().sharesCount + 1
          )
          // Action 5: View count increment
          || (
            existing().isActive == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'updatedAt'])
            && incoming().viewsCount == existing().viewsCount + 1
          )
          // Action 6: Daily vote increment (1 free vote per user per UTC day)
          || (
            existing().isActive == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['votesCount', 'updatedAt'])
            && incoming().votesCount == existing().votesCount + 1
            && !exists(/databases/$(database)/documents/challengeDailyVotes/$(request.auth.uid + '__' + utcDateKey()))
            && existsAfter(/databases/$(database)/documents/challengeDailyVotes/$(request.auth.uid + '__' + utcDateKey()))
            && getAfter(/databases/$(database)/documents/challengeDailyVotes/$(request.auth.uid + '__' + utcDateKey())).data.videoId == videoId
          )
        );

      allow delete: if isVerified()
        && isValidId(videoId)
        && (isOwner(existing().authorId) || isAdmin());

      match /chunks/{chunkId} {
        allow get: if isValidId(videoId) && isValidId(chunkId) && exists(/databases/$(database)/documents/challengeVideos/$(videoId));
        allow list: if isValidId(videoId) && existing().videoId == videoId;
        allow create: if isVerified()
          && isValidId(videoId)
          && isValidId(chunkId)
          && isValidChallengeVideoChunk(incoming())
          && incoming().videoId == videoId
          && incoming().authorId == request.auth.uid
          && exists(/databases/$(database)/documents/challengeVideos/$(videoId))
          && get(/databases/$(database)/documents/challengeVideos/$(videoId)).data.authorId == request.auth.uid;
        allow update: if false;
        allow delete: if isVerified()
          && isValidId(videoId)
          && isValidId(chunkId)
          && (existing().authorId == request.auth.uid || isAdmin());
      }

      match /likes/{userId} {
        allow get: if isValidId(videoId) && isValidId(userId) && isOwner(userId);
        allow list: if isSignedIn() && existing().userId == request.auth.uid;
        allow create: if isVerified()
          && isValidId(videoId)
          && isValidId(userId)
          && isOwner(userId)
          && isValidChallengeVideoLike(incoming())
          && incoming().userId == request.auth.uid
          && incoming().videoId == videoId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/challengeVideos/$(videoId))
          && getAfter(/databases/$(database)/documents/challengeVideos/$(videoId)).data.likesCount == get(/databases/$(database)/documents/challengeVideos/$(videoId)).data.likesCount + 1;
        allow update: if false;
        allow delete: if isVerified()
          && isValidId(videoId)
          && isValidId(userId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/challengeVideos/$(videoId))
          && getAfter(/databases/$(database)/documents/challengeVideos/$(videoId)).data.likesCount == get(/databases/$(database)/documents/challengeVideos/$(videoId)).data.likesCount - 1;
      }

      match /comments/{commentId} {
        allow get: if isValidId(videoId)
          && isValidId(commentId)
          && exists(/databases/$(database)/documents/challengeVideos/$(videoId));
        allow list: if isValidId(videoId) && existing().videoId == videoId;
        allow create: if isVerified()
          && isValidId(videoId)
          && isValidId(commentId)
          && isValidChallengeVideoComment(incoming())
          && incoming().id == commentId
          && incoming().videoId == videoId
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/challengeVideos/$(videoId))
          && getAfter(/databases/$(database)/documents/challengeVideos/$(videoId)).data.commentsCount == get(/databases/$(database)/documents/challengeVideos/$(videoId)).data.commentsCount + 1;
        allow update: if false;
        allow delete: if isVerified()
          && isValidId(videoId)
          && isValidId(commentId)
          && exists(/databases/$(database)/documents/challengeVideos/$(videoId))
          && (
            existing().authorId == request.auth.uid
            || get(/databases/$(database)/documents/challengeVideos/$(videoId)).data.authorId == request.auth.uid
          )
          && getAfter(/databases/$(database)/documents/challengeVideos/$(videoId)).data.commentsCount == get(/databases/$(database)/documents/challengeVideos/$(videoId)).data.commentsCount - 1;
      }

      match /gifts/{giftId} {
        allow get: if isValidId(videoId) && isValidId(giftId) && exists(/databases/$(database)/documents/challengeVideos/$(videoId));
        allow list: if isValidId(videoId) && existing().videoId == videoId;
        allow create: if isVerified()
          && isValidId(videoId)
          && isValidId(giftId)
          && isValidChallengeVideoGift(incoming())
          && incoming().id == giftId
          && incoming().videoId == videoId
          && incoming().senderId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/challengeVideos/$(videoId))
          && getAfter(/databases/$(database)/documents/challengeVideos/$(videoId)).data.giftsCount == get(/databases/$(database)/documents/challengeVideos/$(videoId)).data.giftsCount + 1
          && getAfter(/databases/$(database)/documents/challengeVideos/$(videoId)).data.giftsTotalGhs == get(/databases/$(database)/documents/challengeVideos/$(videoId)).data.giftsTotalGhs + incoming().amountGhs;
        allow update, delete: if false;
      }

      match /boosts/{boostId} {
        allow get: if isSignedIn() && isValidId(videoId) && isValidId(boostId) && (existing().payerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && existing().payerId == request.auth.uid;
        allow create: if isVerified()
          && isValidId(videoId)
          && isValidId(boostId)
          && isValidChallengeVideoBoost(incoming())
          && incoming().id == boostId
          && incoming().videoId == videoId
          && incoming().payerId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/challengeVideos/$(videoId))
          && getAfter(/databases/$(database)/documents/challengeVideos/$(videoId)).data.boostedUntil == incoming().boostedUntil;
        allow update, delete: if false;
      }
    }

    match /creatorSubscriptions/{subId} {
      allow get: if isSignedIn()
        && isValidId(subId)
        && (existing().subscriberId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (existing().subscriberId == request.auth.uid || isAdmin());
      allow create: if isVerified()
        && isValidId(subId)
        && isValidCreatorSubscription(incoming())
        && incoming().id == subId
        && incoming().subscriberId == request.auth.uid
        && subId == request.auth.uid + '__moodspace_pass'
        && incoming().targetId == 'moodspace_pass'
        && incoming().status == 'active'
        && incoming().expiresAt > request.time.toMillis()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(subId)
        && isValidCreatorSubscription(incoming())
        && incoming().subscriberId == request.auth.uid
        && incoming().id == existing().id
        && incoming().subscriberId == existing().subscriberId
        && incoming().targetId == existing().targetId
        && incoming().planType == existing().planType
        && incoming().usdAmount == existing().usdAmount
        && incoming().paymentProvider == existing().paymentProvider
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'currency', 'localAmount', 'country', 'paystackReference', 'expiresAt', 'updatedAt'
        ]);
      allow delete: if isVerified()
        && isValidId(subId)
        && existing().subscriberId == request.auth.uid;
    }
  }
}
