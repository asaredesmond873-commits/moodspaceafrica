      "required": [
        "isPublic", "sponsorName", "prizeGhs", "winnerVideoId", "winnerName",
        "winnerLocation", "winnerTitle", "winnerThumbnailUrl", "winnerRoundLabel", "winnerPrizeGhs", "updatedAt"
      ]
    },
    "CreatorSubscription": {
      "title": "CreatorSubscription",
      "description": "Single $1/week Paystack Creator Pass membership supporting Pan-African currency auto-conversion (GHS, NGN, KES, ZAR, USD).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "subscriberId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "subscriberName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "targetId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "targetName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "planType": { "type": "string", "enum": ["creator_pass"] },
        "usdAmount": { "type": "integer" },
        "currency": { "type": "string", "enum": ["GHS", "NGN", "KES", "ZAR", "USD"] },
        "localAmount": { "type": "number" },
        "country": { "type": "string", "minLength": 2, "maxLength": 80 },
        "paymentProvider": { "type": "string", "enum": ["Paystack"] },
        "paystackReference": { "type": "string", "minLength": 4, "maxLength": 120 },
        "status": { "type": "string", "enum": ["active", "cancelled"] },
        "expiresAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "subscriberId", "subscriberName", "targetId", "targetName",
        "planType", "usdAmount", "currency", "localAmount", "country",
        "paymentProvider", "paystackReference", "status",
        "expiresAt", "createdAt", "updatedAt"
      ]
    },
    "ProfileView": {
      "title": "ProfileView",
      "description": "Profile visit record allowing paid Creator Pass owners to see who viewed their profile.",
      "type": "object",
      "properties": {
        "profileUid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "viewerId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "viewerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "viewerAvatar": { "type": "string", "maxLength": 150000 },
        "viewerLocation": { "type": "string", "maxLength": 100 },
        "viewedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["profileUid", "viewerId", "viewerName", "viewerAvatar", "viewerLocation", "viewedAt"]
    },
    "SavedVideo": {
      "title": "SavedVideo",
      "description": "Owner-only bookmark linking a user to a saved African story video.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "videoId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "videoId", "createdAt"]
    }
  },
  "firestore": {
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
