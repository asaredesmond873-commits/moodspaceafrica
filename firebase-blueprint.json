{
  "entities": {
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Publicly visible creator or business profile without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Firebase Auth UID of the profile owner."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Creator or business display name."
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "Short biography or business overview."
        },
        "location": {
          "type": "string",
          "maxLength": 100,
          "description": "City and country across Africa."
        },
        "accountType": {
          "type": "string",
          "enum": ["creator", "business", "community"],
          "description": "Role of the user on MoodSpace Africa."
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 150000,
          "description": "Avatar image URL or compressed image data URI."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Indicates the profile is discoverable."
        },
        "badgeVerified": {
          "type": "boolean",
          "description": "Admin-approved verification badge status."
        },
        "verifiedLabel": {
          "type": "string",
          "maxLength": 60,
          "description": "Admin-assigned verification label such as Verified Creator or Verified Business."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["uid", "displayName", "bio", "location", "accountType", "avatarUrl", "isPublic", "createdAt", "updatedAt"]
    },
    "FollowRecord": {
      "title": "FollowRecord",
      "description": "Bidirectional social follow link stored under a user's followers and following subcollections.",
      "type": "object",
      "properties": {
        "followerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "UID of the user who is following."
        },
        "followingId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "UID of the user being followed."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name snapshot of the linked user."
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 150000,
          "description": "Avatar URL snapshot of the linked user."
        },
        "location": {
          "type": "string",
          "maxLength": 100,
          "description": "Location snapshot of the linked user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the follow began."
        }
      },
      "required": ["followerId", "followingId", "displayName", "avatarUrl", "location", "createdAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Owner-only private account information containing PII such as email.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "maxLength": 200,
          "description": "Authenticated user email address."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of update."
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "SavedPost": {
      "title": "SavedPost",
      "description": "Private bookmark linking a signed-in user to a saved community post.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Owner Firebase Auth UID."
        },
        "postId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Bookmarked post ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when bookmarked."
        }
      },
      "required": ["userId", "postId", "createdAt"]
    },
    "VerificationRequest": {
      "title": "VerificationRequest",
      "description": "Creator or business identity proof submitted for admin verification review.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Applicant Firebase Auth UID."
        },
        "requesterName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Current display name of applicant."
        },
        "requesterLocation": {
          "type": "string",
          "maxLength": 100,
          "description": "Applicant city and country."
        },
        "accountType": {
          "type": "string",
          "enum": ["creator", "business", "community"],
          "description": "Applicant account role."
        },
        "legalOrBrandName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Official full legal name or registered business/brand name."
        },
        "category": {
          "type": "string",
          "enum": ["creator", "business", "organizer", "media"],
          "description": "Verification badge category requested."
        },
        "idType": {
          "type": "string",
          "enum": ["ghana_card", "business_reg", "social_handle", "website_press"],
          "description": "Type of identity or brand proof provided."
        },
        "idReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Masked Ghana Card, registration reference, official handle, or domain."
        },
        "proofLink": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional verification URL to official social page, press, or website."
        },
        "proofImageUrl": {
          "type": "string",
          "maxLength": 450000,
          "description": "Uploaded proof photo URL or compressed JPEG data URI."
        },
        "note": {
          "type": "string",
          "maxLength": 1000,
          "description": "Applicant explanation and supporting details."
        },
        "proposedLabel": {
          "type": "string",
          "maxLength": 60,
          "description": "Verification label assigned on approval."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Moderation status of the verification request."
        },
        "reviewNote": {
          "type": "string",
          "maxLength": 500,
          "description": "Admin review message or rejection reason."
        },
        "reviewedBy": {
          "type": "string",
          "maxLength": 200,
          "description": "Admin email that processed the review."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial submission."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last submission or review."
        }
      },
      "required": [
        "uid",
        "requesterName",
        "requesterLocation",
        "accountType",
        "legalOrBrandName",
        "category",
        "idType",
        "idReference",
        "proofLink",
        "proofImageUrl",
        "note",
        "proposedLabel",
        "status",
        "reviewNote",
        "reviewedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Post": {
      "title": "Post",
      "description": "Community announcement, event, or promo in text, photo, video, or mixed format with optional adjustable form.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Unique post identifier."
        },
        "authorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "UID of the creator or business."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Snapshot of author display name."
        },
        "authorAvatar": {
          "type": "string",
          "maxLength": 150000,
          "description": "Snapshot of author avatar URL."
        },
        "authorLocation": {
          "type": "string",
          "maxLength": 100,
          "description": "City and country of the author."
        },
        "category": {
          "type": "string",
          "enum": ["announcement", "event", "promo"],
          "description": "Primary post category."
        },
        "mediaFormat": {
          "type": "string",
          "enum": ["text", "photo", "video", "mix"],
          "description": "Media format used in the post."
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "archived"],
          "description": "Discoverability visibility status."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Headline for the post."
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Main body text of the post."
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 450000,
          "description": "Optional photo URL or compressed JPEG data URI."
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 2000,
          "description": "Optional video URL or embed URL."
        },
        "eventDate": {
          "type": "string",
          "maxLength": 60,
          "description": "Optional date/time string for events."
        },
        "eventLocation": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional venue or online location for events."
        },
        "promoCode": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional promotional code or offer tag."
        },
        "hasForm": {
          "type": "boolean",
          "description": "Whether an adjustable creator form is attached."
        },
        "formConfig": {
          "type": "object",
          "description": "Adjustable form definition with title, description, isOpen, and fields list."
        },
        "likesCount": {
          "type": "integer",
          "description": "Atomic count of likes."
        },
        "commentsCount": {
          "type": "integer",
          "description": "Atomic count of comments."
        },
        "sharesCount": {
          "type": "integer",
          "description": "Atomic count of shares."
        },
        "submissionsCount": {
          "type": "integer",
          "description": "Atomic count of form submissions."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "id",
        "authorId",
        "authorName",
        "authorAvatar",
        "authorLocation",
        "category",
        "mediaFormat",
        "visibility",
        "title",
        "content",
        "photoUrl",
        "videoUrl",
        "eventDate",
        "eventLocation",
        "promoCode",
        "hasForm",
        "formConfig",
        "likesCount",
        "commentsCount",
        "sharesCount",
        "submissionsCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "Represents a single user like on a post.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "UID of the user who liked the post."
        },
        "postId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "ID of the liked post."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when liked."
        }
      },
      "required": ["userId", "postId", "createdAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "A user comment on a post.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Unique comment ID."
        },
        "postId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Parent post ID."
        },
        "authorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "UID of the commenter."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the commenter."
        },
        "authorAvatar": {
          "type": "string",
          "maxLength": 150000,
          "description": "Avatar URL of the commenter."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Comment body text."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of comment."
        }
      },
      "required": ["id", "postId", "authorId", "authorName", "authorAvatar", "text", "createdAt"]
    },
    "FormSubmission": {
      "title": "FormSubmission",
      "description": "A response submitted to a post's adjustable form.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Unique submission ID."
        },
        "postId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Parent post ID."
        },
        "postAuthorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "UID of the post creator authorized to view responses."
        },
        "submitterId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "UID of the person submitting the form."
        },
        "submitterName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the submitter."
        },
        "answers": {
          "type": "object",
          "description": "Key-value map of form field IDs to submitted values."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of submission."
        }
      },
      "required": ["id", "postId", "postAuthorId", "submitterId", "submitterName", "answers", "createdAt"]
    },
    "ChallengeVideo": {
      "title": "ChallengeVideo",
      "description": "Vertical video entry for the 14-day MoodSpace Video Arena round (30-90s, <15MB, max 1 per user per round).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "roundId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 64 },
        "authorId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorAvatar": { "type": "string", "maxLength": 150000 },
        "authorLocation": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "caption": { "type": "string", "maxLength": 400 },
        "thumbnailUrl": { "type": "string", "maxLength": 200000 },
        "mimeType": { "type": "string", "maxLength": 60 },
        "durationSeconds": { "type": "number" },
        "fileSizeBytes": { "type": "integer" },
        "chunkCount": { "type": "integer" },
        "videoReady": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "sharesCount": { "type": "integer" },
        "viewsCount": { "type": "integer" },
        "votesCount": { "type": "integer" },
        "giftsCount": { "type": "integer" },
        "giftsTotalGhs": { "type": "integer" },
        "boostedUntil": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "roundId", "authorId", "authorName", "authorAvatar", "authorLocation",
        "title", "caption", "thumbnailUrl", "mimeType", "durationSeconds", "fileSizeBytes",
        "chunkCount", "videoReady", "isActive", "likesCount", "commentsCount", "sharesCount",
        "viewsCount", "votesCount", "giftsCount", "giftsTotalGhs", "boostedUntil", "createdAt", "updatedAt"
      ]
    },
    "ChallengeVideoChunk": {
      "title": "ChallengeVideoChunk",
      "description": "Base64 media chunk belonging to a ChallengeVideo.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "authorId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "index": { "type": "integer" },
        "data": { "type": "string", "maxLength": 750000 }
      },
      "required": ["videoId", "authorId", "index", "data"]
    },
    "ChallengeVideoLike": {
      "title": "ChallengeVideoLike",
      "description": "User like on a ChallengeVideo.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "videoId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "videoId", "createdAt"]
    },
    "ChallengeVideoComment": {
      "title": "ChallengeVideoComment",
      "description": "Comment on a ChallengeVideo.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "videoId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "authorId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorAvatar": { "type": "string", "maxLength": 150000 },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "videoId", "authorId", "authorName", "authorAvatar", "text", "createdAt"]
    },
    "ChallengeVideoGift": {
      "title": "ChallengeVideoGift",
      "description": "Virtual gift sent to a video creator (Rose 2 GHS, Fire 5 GHS, Lion 20 GHS).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "videoId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "senderId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "giftType": { "type": "string", "enum": ["rose", "fire", "lion"] },
        "amountGhs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "videoId", "senderId", "senderName", "giftType", "amountGhs", "createdAt"]
    },
    "ChallengeVideoBoost": {
